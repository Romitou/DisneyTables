# DisneyTables - Environment Configuration Template
# Copy this file to .env and adapt with your own credentials

# ==============================================================================
# DISNEY SERVICES CONFIGURATION (Upstream API)
# ==============================================================================
# Disney mobile API key used in request headers ('x-api-key')
API_KEY=your_disney_mobile_api_key_here

# Disneyland Paris endpoints
AVAILABILITIES_ENDPOINT=https://api.disneylandparis.com/query/dining/availabilities
GRAPHQL_ENDPOINT=https://api.disneylandparis.com/query/graphql
REFRESH_AUTH_ENDPOINT=https://api.disneylandparis.com/auth/token/refresh

# Optional custom headers to mirror official mobile app requests (JSON format)
CUSTOM_HEADERS={"User-Agent":"Disneyland/X.X (iPhone; iOS 16.0)","x-app-id":"disneyland-app"}

# GraphQL query payload to retrieve restaurants catalog
RESTAURANTS_QUERY={"query":"query getActivities { activities { id name drsApp heroMediaMobile { url } } }"}

# ==============================================================================
# DATABASE CONFIGURATION (MySQL / MariaDB via GORM)
# ==============================================================================
# Format: user:password@tcp(host:port)/dbname?charset=utf8mb4&parseTime=True&loc=Local
MYSQL_DSN=disneytables:secret_password@tcp(127.0.0.1:3306)/disneytables?charset=utf8mb4&parseTime=True&loc=Local
DEBUG_MODE=false

# ==============================================================================
# REDIS (Pub/Sub for Real-Time Event Dispatching)
# ==============================================================================
REDIS_HOST=127.0.0.1:6379
REDIS_PASSWORD=

# ==============================================================================
# WEBSERVER & INTERNAL SECURITY
# ==============================================================================
# Bearer token required to interact with DisneyTables REST endpoints
WEBSERVER_TOKEN=generate_a_secure_random_token_here

# Optional listening port (default Gin behavior or 8080)
PORT=8080

# ==============================================================================
# SCHEDULER & RATE-LIMITING CONTROLS (Fair-use Disney API engine)
# ==============================================================================
# Maximum number of checks executed per minute (default: 5)
MAX_REQUESTS_PER_MINUTE=5

# Hourly multiplier map (JSON: hour -> factor) for eco mode / off-peak throttling
# Example: 0.2 at 3 AM (1 req/min), 1.5 at 11 AM during peak booking openings
REQUEST_MODIFIERS={"0":0.2,"1":0.2,"2":0.2,"3":0.2,"4":0.2,"5":0.5,"6":0.8,"7":1.0,"8":1.2,"9":1.5,"10":1.5,"11":1.5,"12":1.2,"18":1.2,"23":0.5}

# ==============================================================================
# OBSERVABILITY & MONITORING
# ==============================================================================
# Sentry DSN for error reporting and performance tracking (optional)
SENTRY_DSN=
